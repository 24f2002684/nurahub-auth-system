# Environment variables & secrets
.env
.env.local
*.env

# Certificates and keys
certs/*.pem
certs/*.key
certs/*.crt
!certs/.gitkeep

# Composer dependencies
/vendor/
composer.phar

# Logs and runtime data
*.log
/logs/
/docker/data/

# Database dumps with local/sensitive data
*.sql.gz
*.dump
dump/

# Temporary files & cache
*.tmp
*.temp
.cache/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE & editor directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.gemini/
