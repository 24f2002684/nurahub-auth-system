# ==============================================================================
# NuraHub Auth & User Profile System - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust values for your local or production setup.
# NEVER commit the actual .env file containing sensitive credentials to git.

# Application Configuration
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost:8080

# MySQL Configuration (User Accounts & Authentication)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nurahub_auth
MYSQL_USER=nurahub_user
MYSQL_PASSWORD=nurahub_secret_password
MYSQL_CHARSET=utf8mb4

# MongoDB Configuration (Extended User Profiles)
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=nurahub_profiles
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
# Or provide a complete connection URI (optional override):
# MONGO_URI=mongodb://127.0.0.1:27017/nurahub_profiles

# Redis Configuration (PHP Session Storage)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2.5
REDIS_PREFIX=PHPREDIS_SESSION:

# Session Security Configuration
SESSION_LIFETIME=3600
SESSION_COOKIE_NAME=nurahub_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
