# ==============================================================================
# NuraHub Auth & User Profile System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for local development or hosted cloud services.
# NEVER commit the actual .env file with real credentials to source control.

# ------------------------------------------------------------------------------
# Application Runtime Settings
# ------------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost:8080
# Web server listening port (Render automatically provides $PORT, defaults to 10000)
PORT=10000

# ------------------------------------------------------------------------------
# MySQL Configuration (User Accounts & Authentication)
# Compatible with Local MySQL or Aiven Free MySQL
# ------------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nurahub_auth
MYSQL_USER=nurahub_user
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_CHARSET=utf8mb4

# TLS/SSL Settings for Aiven MySQL:
# Set to 'REQUIRED' for Aiven. Provide either local file path in MYSQL_SSL_CA or inline PEM in MYSQL_SSL_CA_CONTENT
MYSQL_SSL_MODE=PREFERRED
MYSQL_SSL_CA=certs/aiven-ca.pem
# MYSQL_SSL_CA_CONTENT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ------------------------------------------------------------------------------
# MongoDB Configuration (Extended User Profiles)
# Compatible with Local MongoDB or MongoDB Atlas Free Cluster
# ------------------------------------------------------------------------------
# Atlas connection string format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=nurahub_profiles

# Legacy / Individual Mongo connection parameters (used if MONGODB_URI is blank)
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=nurahub_profiles
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin

# ------------------------------------------------------------------------------
# Redis Configuration (PHP Session Storage)
# Compatible with Local Redis or Upstash Free Redis over TLS
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Enable TLS for Upstash Redis (set to true)
REDIS_TLS=false
REDIS_TIMEOUT=3.0
REDIS_PREFIX=PHPREDIS_SESSION:

# Optional Redis connection URL (e.g. rediss://default:<token>@<endpoint>:6379)
# REDIS_URL=

# ------------------------------------------------------------------------------
# Session & Cookie Security Configuration
# ------------------------------------------------------------------------------
SESSION_LIFETIME=3600
SESSION_COOKIE_NAME=nurahub_session
# In production or HTTPS environments, secure cookies are automatically enforced
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
